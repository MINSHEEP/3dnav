<?xml version="1.0"?>
<robot name="robot_description" xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!--
      base_link is the URDF root. Small Point-LIO dynamically publishes
      odom -> base_footprint -> base_link so the navigation frame stays
      planar while the body frame retains height, roll, and pitch.
    -->
    <!-- 机器人底盘 -->
    <link name="base_link">
        <visual>
            <origin xyz="0 0 0.12" rpy="0 0 0"/>
            <geometry>
                <cylinder length="0.24" radius="0.22"/>
            </geometry>
            <material name="blue">
                <color rgba="0.1 0.1 1.0 0.5" /> 
            </material>
        </visual>
        <collision>
            <origin xyz="0 0 0.12" rpy="0 0 0"/>
            <geometry>
                <cylinder length="0.24" radius="0.22"/>
            </geometry>
        </collision>
        <inertial>
            <mass value="5.0"/>  <!-- 根据实际机器人重量调整 -->
            <inertia ixx="0.1" ixy="0.0" ixz="0.0" iyy="0.1" iyz="0.0" izz="0.2"/>
        </inertial>
    </link>

    <!-- Livox 传感器 -->
    <link name="livox_frame">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <cylinder length="0.02" radius="0.02"/>
            </geometry>
            <material name="black">
                <color rgba="0.0 0.0 0.0 0.5" /> 
            </material>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <cylinder length="0.02" radius="0.02"/>
            </geometry>
        </collision>
        <inertial>
            <mass value="0.2"/>  <!-- 增加一点质量 -->
            <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0002"/>
        </inertial>
    </link>
    
    <!-- 连接底盘和传感器的固定关节 -->
    <joint name="laser_joint" type="fixed">
        <parent link="base_link" />
        <child link="livox_frame" />
        <origin xyz="0.23 0 0.38" rpy="0 0.523599 0"/>
    </joint>

    <!-- 可选：添加其他链接如轮子等 -->
    <!--
    <link name="wheel_left_link">
        <visual>
            <origin xyz="0 0 0" rpy="1.570796 0 0"/>
            <geometry>
                <cylinder radius="0.05" length="0.04"/>
            </geometry>
        </visual>
    </link>
    -->

</robot>
